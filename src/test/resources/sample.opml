    <body>
        <outline text="第一章" _note="第一章的内容描述">
            <outline text="1.1 小节" _note="第一小节的详细内容">
                <outline text="1.1.1 子小节" _note="子小节的内容"/>
            </outline>
            <outline text="1.2 小节" _note="第二小节的详细内容"/>
        </outline>
        <outline text="第二章" _note="第二章的内容描述">
            <outline text="2.1 小节" _note="第二章第一小节的内容"/>
        </outline>
    </body>
